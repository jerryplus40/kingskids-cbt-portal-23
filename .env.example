# King's Kids CBT Portal — local secrets. This file is git-ignored; never commit it.
# Only variables starting with VITE_ are built into the website. Everything else stays on
# this machine and is used to deploy the database and to configure the edge functions.

# ---------------------------------------------------------------------------
# Website (safe to expose in the browser)
# Supabase dashboard > Project Settings > API
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Deployment (secret: server side only)
# ---------------------------------------------------------------------------
# Project reference, from the URL above
SUPABASE_PROJECT_REF=your-project-ref
# Project Settings > Database > Database password (needed to apply the migrations)
SUPABASE_DB_PASSWORD=
# Project Settings > API > service_role key (used once, to create the first administrator)
SUPABASE_SERVICE_ROLE_KEY=
# Account > Access tokens at supabase.com/dashboard/account/tokens (lets the CLI deploy to this project)
SUPABASE_ACCESS_TOKEN=

# First administrator account, created after the database is set up
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_FIRST_NAME=
FIRST_ADMIN_LAST_NAME=

# ---------------------------------------------------------------------------
# Edge function secrets (pushed to Supabase with `supabase secrets set`)
# Leave a provider blank to switch that feature off; nothing else breaks.
# ---------------------------------------------------------------------------
# The live site address, used in payment return links and CORS
SITE_URL=https://www.kingskidschools.com
ALLOWED_ORIGIN=https://www.kingskidschools.com

# Paystack (entrance application fees): dashboard.paystack.com > Settings > API Keys & Webhooks
# Use the sk_test_ key first; set the webhook URL to
# https://your-project-ref.supabase.co/functions/v1/paystack-webhook
PAYSTACK_SECRET_KEY=

# Termii (SMS to parents): accounts.termii.com > API settings
TERMII_API_KEY=
# Your approved sender ID (up to 11 characters), e.g. KingsKids
TERMII_SENDER_ID=
# Base URL shown on your Termii dashboard (accounts created after 2024 get their own)
TERMII_BASE_URL=https://api.ng.termii.com
# "dnd" reaches numbers on Do-Not-Disturb but needs a sender ID approved for it; otherwise "generic"
TERMII_CHANNEL=generic

# Resend (email to staff and parents): resend.com > API Keys; verify the sending domain first
RESEND_API_KEY=
EMAIL_FROM=King's Kids CBT <noreply@kingskidschools.com>

# Any long random string; lets a scheduled job call send-notifications without signing in
CRON_SECRET=
